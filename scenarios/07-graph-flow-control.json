      }
    },
    {
      "_note": "Housekeeping: clear debris from an aborted earlier run.",
      "tool": "call_function",
      "params": {
        "object_path": "subsystem:EditorAssetSubsystem",
        "function": "DeleteAsset",
        "args": {
          "AssetPathToDelete": "/Game/UplinkScenarios/BP_FlowScenario"
