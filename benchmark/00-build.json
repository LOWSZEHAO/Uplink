{
  "_name": "Benchmark build",
  "_purpose": "Build the whole benchmark game from nothing: four Blueprints with components, variables, event dispatchers and event graphs, then place them in the current level. Run once before 01-golden-path. Kept as a scenario rather than as .uasset files so the benchmark is reproducible in any project and readable as a diff - and because building a small game in one request is a fair demonstration of what the authoring tools do.",
  "steps": [
    {
      "_note": "Housekeeping: clear anything an earlier run left, actors before the classes they instance.",
      "tool": "delete_actors",
      "params": { "names": ["Bench_Cube", "Bench_Plate", "Bench_Door", "Bench_Exit"], "world": "editor" }
    },
    { "tool": "call_function", "params": { "object_path": "subsystem:EditorAssetSubsystem", "function": "DeleteDirectory", "args": { "DirectoryPath": "/Game/UplinkBenchmark" } } },

    { "tool": "bp_create", "params": { "path": "/Game/UplinkBenchmark/BP_Bench_Cube", "parent_class": "/Script/Engine.Actor" } },
    { "tool": "bp_create", "params": { "path": "/Game/UplinkBenchmark/BP_Bench_Plate", "parent_class": "/Script/Engine.Actor" } },
    { "tool": "bp_create", "params": { "path": "/Game/UplinkBenchmark/BP_Bench_Door", "parent_class": "/Script/Engine.Actor" } },
    { "tool": "bp_create", "params": { "path": "/Game/UplinkBenchmark/BP_Bench_Exit", "parent_class": "/Script/Engine.Actor" } },

    { "tool": "bp_add_component", "params": { "blueprint": "/Game/UplinkBenchmark/BP_Bench_Cube", "class": "StaticMeshComponent", "name": "Mesh", "static_mesh": "/Engine/BasicShapes/Cube.Cube", "collision_profile": "OverlapAllDynamic", "scale": { "x": 0.4, "y": 0.4, "z": 0.4 }, "compile": true } },
    { "tool": "bp_add_component", "params": { "blueprint": "/Game/UplinkBenchmark/BP_Bench_Plate", "class": "BoxComponent", "name": "Trigger", "collision_profile": "OverlapAllDynamic", "scale": { "x": 2, "y": 2, "z": 0.5 }, "compile": true } },
    { "tool": "bp_add_component", "params": { "blueprint": "/Game/UplinkBenchmark/BP_Bench_Door", "class": "StaticMeshComponent", "name": "Mesh", "static_mesh": "/Engine/BasicShapes/Cube.Cube", "collision_profile": "BlockAll", "scale": { "x": 2, "y": 0.2, "z": 3 }, "compile": true } },
    { "tool": "bp_add_component", "params": { "blueprint": "/Game/UplinkBenchmark/BP_Bench_Exit", "class": "BoxComponent", "name": "Trigger", "collision_profile": "OverlapAllDynamic", "scale": { "x": 2, "y": 2, "z": 2 }, "compile": true } },

    {
      "_note": "The cube. Overlap a pawn, and if it is not already carried, attach to that pawn and announce it. SnapToTarget on the location rule matters: KeepRelative preserves the cube's old world offset, so it 'attaches' and then hangs several metres away, which reads as a pickup that worked and a plate that is broken.",
      "tool": "bp_modify",
      "params": {
        "blueprint": "/Game/UplinkBenchmark/BP_Bench_Cube",
        "ops": [
          { "op": "add_variable", "name": "bIsCarried", "type": "bool", "instance_editable": true },
          { "op": "add_dispatcher", "name": "OnPickedUp" },
          { "op": "override_function", "name": "ReceiveActorBeginOverlap", "ref": "ov" },
          { "op": "add_node", "kind": "cast", "class": "/Script/Engine.Pawn", "ref": "cast" },
          { "op": "add_node", "kind": "variable_get", "name": "bIsCarried", "ref": "getCarried" },
          { "op": "add_node", "kind": "call_function", "class": "/Script/Engine.KismetMathLibrary", "function": "Not_PreBool", "ref": "not" },
          { "op": "add_node", "kind": "branch", "ref": "br" },
          { "op": "add_node", "kind": "call_function", "function": "K2_AttachToActor", "ref": "attach" },
          { "op": "add_node", "kind": "variable_set", "name": "bIsCarried", "ref": "setCarried" },
          { "op": "add_node", "kind": "call_dispatcher", "name": "OnPickedUp", "ref": "fire" },
          { "op": "connect", "from_node": "@ov", "from_pin": "OtherActor", "to_node": "@cast", "to_pin": "Object" },
          { "op": "connect", "from_node": "@ov", "from_pin": "then", "to_node": "@cast", "to_pin": "execute" },
          { "op": "connect", "from_node": "@getCarried", "from_pin": "bIsCarried", "to_node": "@not", "to_pin": "A" },
          { "op": "connect", "from_node": "@not", "from_pin": "ReturnValue", "to_node": "@br", "to_pin": "Condition" },
          { "op": "connect", "from_node": "@cast", "from_pin": "then", "to_node": "@br", "to_pin": "execute" },
          { "op": "connect", "from_node": "@br", "from_pin": "Then", "to_node": "@attach", "to_pin": "execute" },
          { "op": "connect", "from_node": "@cast", "from_pin": "AsPawn", "to_node": "@attach", "to_pin": "ParentActor" },
          { "op": "set_pin_default", "node": "@attach", "pin": "LocationRule", "value": "SnapToTarget" },
          { "op": "set_pin_default", "node": "@attach", "pin": "RotationRule", "value": "SnapToTarget" },
          { "op": "connect", "from_node": "@attach", "from_pin": "then", "to_node": "@setCarried", "to_pin": "execute" },
          { "op": "set_pin_default", "node": "@setCarried", "pin": "bIsCarried", "value": "true" },
          { "op": "connect", "from_node": "@setCarried", "from_pin": "then", "to_node": "@fire", "to_pin": "execute" },
          { "op": "arrange" }
        ],
        "compile": true
      }
    },
    {
      "_note": "The plate reacts to the CUBE and not to a pawn, which is what makes the chain a chain: standing on it empty-handed does nothing.",
      "tool": "bp_modify",
      "params": {
        "blueprint": "/Game/UplinkBenchmark/BP_Bench_Plate",
        "ops": [
          { "op": "add_variable", "name": "bIsPressed", "type": "bool", "instance_editable": true },
          { "op": "add_dispatcher", "name": "OnPressed" },
          { "op": "override_function", "name": "ReceiveActorBeginOverlap", "ref": "ov" },
          { "op": "add_node", "kind": "cast", "class": "/Game/UplinkBenchmark/BP_Bench_Cube.BP_Bench_Cube_C", "ref": "cast" },
          { "op": "add_node", "kind": "variable_set", "name": "bIsPressed", "ref": "set" },
          { "op": "add_node", "kind": "call_dispatcher", "name": "OnPressed", "ref": "fire" },
          { "op": "connect", "from_node": "@ov", "from_pin": "OtherActor", "to_node": "@cast", "to_pin": "Object" },
          { "op": "connect", "from_node": "@ov", "from_pin": "then", "to_node": "@cast", "to_pin": "execute" },
          { "op": "connect", "from_node": "@cast", "from_pin": "then", "to_node": "@set", "to_pin": "execute" },
          { "op": "set_pin_default", "node": "@set", "pin": "bIsPressed", "value": "true" },
          { "op": "connect", "from_node": "@set", "from_pin": "then", "to_node": "@fire", "to_pin": "execute" },
          { "op": "arrange" }
        ],
        "compile": true
      }
    },
    {
      "_note": "The door finds the plate at BeginPlay and binds its OnPressed - a real cross-actor dispatcher subscription, not a tick poll. MakeVector rather than a Make Struct node: FVector has a native make function, so the struct node is rejected at compile with 'the structure Make Vector is not a BlueprintType'.",
      "tool": "bp_modify",
      "params": {
        "blueprint": "/Game/UplinkBenchmark/BP_Bench_Door",
        "ops": [
          { "op": "add_variable", "name": "bIsOpen", "type": "bool", "instance_editable": true },
          { "op": "add_variable", "name": "OpenHeight", "type": "float", "instance_editable": true, "default": "300.0" },
          { "op": "override_function", "name": "ReceiveBeginPlay", "ref": "bp" },
          { "op": "add_node", "kind": "self", "ref": "me" },
          { "op": "add_node", "kind": "call_function", "class": "/Script/Engine.GameplayStatics", "function": "GetAllActorsOfClass", "ref": "getAll" },
          { "op": "add_node", "kind": "call_function", "class": "/Script/Engine.KismetArrayLibrary", "function": "Array_Get", "ref": "first" },
          { "op": "add_node", "kind": "bind_dispatcher", "name": "OnPressed", "target": "/Game/UplinkBenchmark/BP_Bench_Plate.BP_Bench_Plate_C", "ref": "bind" },
          { "op": "add_node", "kind": "custom_event", "name": "HandlePlatePressed", "ref": "handler" },
          { "op": "add_node", "kind": "call_function", "function": "K2_AddActorWorldOffset", "ref": "move" },
          { "op": "add_node", "kind": "call_function", "class": "/Script/Engine.KismetMathLibrary", "function": "MakeVector", "ref": "vec" },
          { "op": "add_node", "kind": "variable_get", "name": "OpenHeight", "ref": "height" },
          { "op": "add_node", "kind": "variable_set", "name": "bIsOpen", "ref": "setOpen" },
          { "op": "connect", "from_node": "@bp", "from_pin": "then", "to_node": "@getAll", "to_pin": "execute" },
          { "op": "connect", "from_node": "@me", "from_pin": "self", "to_node": "@getAll", "to_pin": "WorldContextObject" },
          { "op": "set_pin_default", "node": "@getAll", "pin": "ActorClass", "value": "/Game/UplinkBenchmark/BP_Bench_Plate.BP_Bench_Plate_C" },
          { "op": "connect", "from_node": "@getAll", "from_pin": "OutActors", "to_node": "@first", "to_pin": "TargetArray" },
          { "op": "connect", "from_node": "@getAll", "from_pin": "then", "to_node": "@bind", "to_pin": "execute" },
          { "op": "connect", "from_node": "@first", "from_pin": "Item", "to_node": "@bind", "to_pin": "self" },
          { "op": "connect", "from_node": "@handler", "from_pin": "OutputDelegate", "to_node": "@bind", "to_pin": "Delegate" },
          { "op": "connect", "from_node": "@handler", "from_pin": "then", "to_node": "@move", "to_pin": "execute" },
          { "op": "connect", "from_node": "@height", "from_pin": "OpenHeight", "to_node": "@vec", "to_pin": "Z" },
          { "op": "connect", "from_node": "@vec", "from_pin": "ReturnValue", "to_node": "@move", "to_pin": "DeltaLocation" },
          { "op": "connect", "from_node": "@move", "from_pin": "then", "to_node": "@setOpen", "to_pin": "execute" },
          { "op": "set_pin_default", "node": "@setOpen", "pin": "bIsOpen", "value": "true" },
          { "op": "arrange" }
        ],
        "compile": true
      }
    },
    {
      "tool": "bp_modify",
      "params": {
        "blueprint": "/Game/UplinkBenchmark/BP_Bench_Exit",
        "ops": [
          { "op": "add_variable", "name": "bReached", "type": "bool", "instance_editable": true },
          { "op": "add_dispatcher", "name": "OnReached" },
          { "op": "override_function", "name": "ReceiveActorBeginOverlap", "ref": "ov" },
          { "op": "add_node", "kind": "cast", "class": "/Script/Engine.Pawn", "ref": "cast" },
          { "op": "add_node", "kind": "variable_set", "name": "bReached", "ref": "set" },
          { "op": "add_node", "kind": "call_dispatcher", "name": "OnReached", "ref": "fire" },
          { "op": "connect", "from_node": "@ov", "from_pin": "OtherActor", "to_node": "@cast", "to_pin": "Object" },
          { "op": "connect", "from_node": "@ov", "from_pin": "then", "to_node": "@cast", "to_pin": "execute" },
          { "op": "connect", "from_node": "@cast", "from_pin": "then", "to_node": "@set", "to_pin": "execute" },
          { "op": "set_pin_default", "node": "@set", "pin": "bReached", "value": "true" },
          { "op": "connect", "from_node": "@set", "from_pin": "then", "to_node": "@fire", "to_pin": "execute" },
          { "op": "arrange" }
        ],
        "compile": true
      }
    },

    { "tool": "save", "params": { "asset": "/Game/UplinkBenchmark/BP_Bench_Cube" } },
    { "tool": "save", "params": { "asset": "/Game/UplinkBenchmark/BP_Bench_Plate" } },
    { "tool": "save", "params": { "asset": "/Game/UplinkBenchmark/BP_Bench_Door" } },
    { "tool": "save", "params": { "asset": "/Game/UplinkBenchmark/BP_Bench_Exit" } },

    {
      "_note": "Placed in a line the player can walk. The coordinates suit the third-person template's platform; on another map, move them.",
      "tool": "spawn_actor",
      "params": { "class_path": "/Game/UplinkBenchmark/BP_Bench_Cube.BP_Bench_Cube_C", "location": { "x": 300, "y": 0, "z": 320 }, "label": "Bench_Cube", "world": "editor" }
    },
    { "tool": "spawn_actor", "params": { "class_path": "/Game/UplinkBenchmark/BP_Bench_Plate.BP_Bench_Plate_C", "location": { "x": 800, "y": 0, "z": 310 }, "label": "Bench_Plate", "world": "editor" } },
    { "tool": "spawn_actor", "params": { "class_path": "/Game/UplinkBenchmark/BP_Bench_Door.BP_Bench_Door_C", "location": { "x": 1200, "y": 0, "z": 450 }, "label": "Bench_Door", "world": "editor" } },
    { "tool": "spawn_actor", "params": { "class_path": "/Game/UplinkBenchmark/BP_Bench_Exit.BP_Bench_Exit_C", "location": { "x": 1700, "y": 0, "z": 380 }, "label": "Bench_Exit", "world": "editor" } },
    { "tool": "call_function", "params": { "object_path": "subsystem:LevelEditorSubsystem", "function": "SaveCurrentLevel" } }
  ]
}
